{
  "name": "syrax",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26.0.0"
  },
  "scripts": {
    "format": "prettier --write .",
    "check:format": "prettier --check .",
    "check:lint": "oxlint --deny-warnings src test",
    "check:types": "tsc --noEmit",
    "test": "node --test --test-reporter=spec \"test/**/*.test.ts\"",
    "generate-config": "node src/cli/generate-config.ts"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "oxlint": "1.79.0",
    "prettier": "3.9.6",
    "typescript": "7.0.2"
  }
}
