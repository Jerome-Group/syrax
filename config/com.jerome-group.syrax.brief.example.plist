<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.jerome-group.syrax.brief</string>

	<key>ProgramArguments</key>
	<array>
		<string>/usr/bin/curl</string>
		<string>--fail</string>
		<string>--silent</string>
		<string>--show-error</string>
		<string>-X</string>
		<string>POST</string>
		<string>http://127.0.0.1:18792/brief</string>
	</array>

	<key>StartCalendarInterval</key>
	<dict>
		<key>Hour</key>
		<integer>7</integer>
		<key>Minute</key>
		<integer>0</integer>
	</dict>
</dict>
</plist>
