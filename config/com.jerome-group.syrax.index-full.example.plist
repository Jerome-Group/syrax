<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.jerome-group.syrax.index-full</string>

	<key>ProgramArguments</key>
	<array>
		<string>/usr/bin/curl</string>
		<string>--fail</string>
		<string>--silent</string>
		<string>--show-error</string>
		<string>-X</string>
		<string>POST</string>
		<string>http://127.0.0.1:18790/index/full</string>
	</array>

	<key>StartCalendarInterval</key>
	<dict>
		<key>Day</key>
		<array>
			<integer>1</integer>
			<integer>4</integer>
			<integer>7</integer>
			<integer>10</integer>
			<integer>13</integer>
			<integer>16</integer>
			<integer>19</integer>
			<integer>22</integer>
			<integer>25</integer>
			<integer>28</integer>
		</array>
		<key>Hour</key>
		<integer>4</integer>
		<key>Minute</key>
		<integer>30</integer>
	</dict>
</dict>
</plist>
