  "stateDir": "/absolute/path/outside/this/repository/runtime-state",
  "workspace": "/absolute/path/outside/this/repository/workspace",
  "secretsStore": "/absolute/path/outside/this/repository/secrets/syrax.json",
  "carrierMap": "/absolute/path/outside/this/repository/runtime-state/carriers.json",
  "logsDir": "/absolute/path/outside/this/repository/logs",
  "wrapperPath": "/absolute/path/outside/this/repository/bin/start-gateway.sh",
  "searchRoot": "/absolute/path/outside/this/repository/search-env",
  "searchIndex": "/absolute/path/outside/this/repository/search-index",
  "searchWrapperPath": "/absolute/path/outside/this/repository/bin/start-search.sh",
  "monitorState": "/absolute/path/outside/this/repository/lane-monitor",
  "monitorWrapperPath": "/absolute/path/outside/this/repository/bin/start-monitor.sh",
  "academicWrapperPath": "/absolute/path/outside/this/repository/bin/start-academic.sh",
  "academicOsRoot": "/absolute/path/to/the/academic-os/checkout",
  "academicOsConfig": "/absolute/path/outside/this/repository/academic-os.config.json",
  "academicOsState": "/absolute/path/outside/this/repository/academic-os-state",
  "ntulearnRoot": "/absolute/path/to/the/ntulearn/checkout",
